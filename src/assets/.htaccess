# Filmy i dźwięk muszą wychodzić bez kompresji: skompresowana odpowiedź nie ma
# Content-Length ani obsługi żądań zakresowych (Range), a bez nich Safari na
# iPhonie nie odtwarza wideo (zostaje sama okładka).
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI "\.(mp4|m4v|webm|mov|mp3|m4a|ogg|wav)$" no-gzip no-brotli dont-vary
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|m4v|webm|mov|mp3|m4a|ogg|wav)$">
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>
